# Optional AWS configuration for Athlelorien collaborators.
# Copy to .env only when environment variables or an AWS profile are not
# already configured. Never commit real credentials.

AWS_DEFAULT_REGION=eu-west-2
S3_BUCKET=ucl-ai-soccormon-dataset

# Option A: short- or long-lived access keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Option B: a profile from ~/.aws/credentials or ~/.aws/config.
AWS_PROFILE=
